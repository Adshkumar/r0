{
  "$schema": "https://adshkumar.is-a.dev/schemas/extension.json",
  "id": "r0.solidity",
  "name": "Solidity",
  "displayName": "Solidity",
  "version": "1.0.0",
  "description": "Solidity language support with LSP",
  "publisher": "R0",
  "categories": ["Language"],
  "languages": [
    {
      "id": "solidity",
      "extensions": [".sol"],
      "aliases": ["Solidity"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "solidity-language-server",
      "runtime": "binary",
      "args": ["--stdio"]
    }
  }
}
