{
  "$schema": "https://adshkumar.is-a.dev/schemas/extension.json",
  "id": "r0.csharp",
  "name": "CSharp",
  "displayName": "C#",
  "version": "1.0.0",
  "description": "C# language support with LSP",
  "publisher": "R0",
  "categories": ["Language"],
  "languages": [
    {
      "id": "csharp",
      "extensions": [".cs"],
      "aliases": ["C#", "CSharp", "csharp"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "omnisharp",
      "runtime": "binary",
      "args": ["--languageserver"]
    }
  }
}
