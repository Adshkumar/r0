{
  "$schema": "https://adshkumar.is-a.dev/schemas/extension.json",
  "id": "r0.svelte",
  "name": "Svelte",
  "displayName": "Svelte",
  "version": "1.0.0",
  "description": "Svelte language support with LSP and formatting",
  "publisher": "R0",
  "categories": ["Language"],
  "languages": [
    {
      "id": "svelte",
      "extensions": [".svelte"],
      "aliases": ["Svelte"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "svelteserver",
      "runtime": "bun",
      "package": "svelte-language-server",
      "args": ["--stdio"]
    },
    "formatter": {
      "name": "prettier",
      "runtime": "bun",
      "package": "prettier",
      "args": ["--plugin", "prettier-plugin-svelte", "--stdin-filepath", "${file}"]
    }
  }
}
