{
  "$schema": "https://adshkumar.is-a.dev/schemas/extension.json",
  "id": "r0.yaml",
  "name": "YAML",
  "displayName": "YAML",
  "version": "1.0.0",
  "description": "YAML language support with LSP and formatting",
  "publisher": "R0",
  "categories": ["Language"],
  "languages": [
    {
      "id": "yaml",
      "extensions": [".yaml", ".yml"],
      "aliases": ["YAML"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "yaml-language-server",
      "runtime": "bun",
      "package": "yaml-language-server",
      "args": ["--stdio"]
    },
    "formatter": {
      "name": "prettier",
      "runtime": "bun",
      "package": "prettier",
      "args": ["--stdin-filepath", "${file}"]
    }
  }
}
