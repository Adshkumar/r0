{
  "$schema": "https://adshkumar.is-a.dev/schemas/extension.json",
  "id": "r0.toml",
  "name": "TOML",
  "displayName": "TOML",
  "version": "1.0.0",
  "description": "TOML language support with LSP and formatting",
  "publisher": "R0",
  "categories": ["Language"],
  "languages": [
    {
      "id": "toml",
      "extensions": [".toml"],
      "aliases": ["TOML"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "taplo",
      "runtime": "rust",
      "package": "taplo-cli",
      "args": ["lsp", "stdio"]
    },
    "formatter": {
      "name": "taplo",
      "runtime": "rust",
      "package": "taplo-cli",
      "args": ["format", "-"]
    }
  }
}
