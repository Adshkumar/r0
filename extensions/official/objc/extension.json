{
  "$schema": "https://adshkumar.is-a.dev/schemas/extension.json",
  "id": "r0.objc",
  "name": "ObjectiveC",
  "displayName": "Objective-C",
  "version": "1.0.0",
  "description": "Objective-C language support with LSP",
  "publisher": "R0",
  "categories": ["Language"],
  "languages": [
    {
      "id": "objc",
      "extensions": [".m", ".mm", ".h"],
      "aliases": ["Objective-C", "ObjC", "objc"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "clangd",
      "runtime": "binary",
      "args": ["--background-index"]
    }
  }
}
