{
  "$schema": "https://adshkumar.is-a.dev/schemas/extension.json",
  "id": "r0.database.duckdb",
  "name": "DuckDB",
  "displayName": "DuckDB Provider",
  "version": "1.0.0",
  "description": "DuckDB database browser and query provider.",
  "publisher": "R0",
  "categories": ["Database"],
  "activationEvents": ["onDatabase:duckdb"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Adshkumar/r0/tree/master/extensions/official/duckdb"
  },
  "icon": "icon.svg",
  "databases": [
    {
      "id": "duckdb",
      "label": "DuckDB",
      "isFileBased": true,
      "protocolVersion": 1,
      "fileExtensions": [".duckdb", ".duck"],
      "sidecar": {
        "darwin-arm64": "bin/r0-db-duckdb",
        "darwin-x64": "bin/r0-db-duckdb",
        "linux-arm64": "bin/r0-db-duckdb",
        "linux-x64": "bin/r0-db-duckdb",
        "win32-x64": "bin/r0-db-duckdb.exe"
      }
    }
  ]
}
