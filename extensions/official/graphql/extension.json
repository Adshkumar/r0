{
  "$schema": "https://adshkumar.is-a.dev/schemas/extension.json",
  "id": "r0.graphql",
  "name": "GraphQL",
  "displayName": "GraphQL",
  "version": "1.0.0",
  "description": "GraphQL language support with LSP and formatting",
  "publisher": "R0",
  "categories": ["Language"],
  "languages": [
    {
      "id": "graphql",
      "extensions": [".graphql", ".gql"],
      "aliases": ["GraphQL", "gql"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "graphql-lsp",
      "runtime": "bun",
      "package": "graphql-language-service-cli",
      "args": ["server", "-m", "stream"]
    },
    "formatter": {
      "name": "prettier",
      "runtime": "bun",
      "package": "prettier",
      "args": ["--parser", "graphql", "--stdin-filepath", "${file}"]
    }
  }
}
