{
  "$schema": "https://adshkumar.is-a.dev/schemas/extension.json",
  "id": "r0.zig",
  "name": "Zig",
  "displayName": "Zig",
  "version": "1.0.0",
  "description": "Zig language support with LSP",
  "publisher": "R0",
  "categories": ["Language"],
  "languages": [
    {
      "id": "zig",
      "extensions": [".zig", ".zon"],
      "aliases": ["Zig"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "zls",
      "runtime": "binary",
      "args": []
    },
    "formatter": {
      "name": "zig",
      "runtime": "binary",
      "args": ["fmt", "--stdin"]
    }
  }
}
