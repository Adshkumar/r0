{
  "$schema": "https://adshkumar.is-a.dev/schemas/extension.json",
  "id": "r0.database.mysql",
  "name": "MySQL",
  "displayName": "MySQL Provider",
  "version": "1.0.0",
  "description": "MySQL connection, schema, and query provider.",
  "publisher": "R0",
  "categories": ["Database"],
  "activationEvents": ["onDatabase:mysql"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Adshkumar/r0/tree/master/extensions/official/mysql"
  },
  "icon": "icon.svg",
  "databases": [
    {
      "id": "mysql",
      "label": "MySQL",
      "isFileBased": false,
      "protocolVersion": 1,
      "defaultPort": 3306,
      "sidecar": {
        "darwin-arm64": "bin/r0-db-mysql",
        "darwin-x64": "bin/r0-db-mysql",
        "linux-arm64": "bin/r0-db-mysql",
        "linux-x64": "bin/r0-db-mysql",
        "win32-x64": "bin/r0-db-mysql.exe"
      }
    }
  ]
}
