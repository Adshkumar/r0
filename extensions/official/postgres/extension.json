{
  "$schema": "https://adshkumar.is-a.dev/schemas/extension.json",
  "id": "r0.database.postgres",
  "name": "PostgreSQL",
  "displayName": "PostgreSQL Provider",
  "version": "1.0.0",
  "description": "PostgreSQL connection, schema, and query provider.",
  "publisher": "R0",
  "categories": ["Database"],
  "activationEvents": ["onDatabase:postgres"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Adshkumar/r0/tree/master/extensions/official/postgres"
  },
  "icon": "icon.svg",
  "databases": [
    {
      "id": "postgres",
      "label": "PostgreSQL",
      "isFileBased": false,
      "protocolVersion": 1,
      "defaultPort": 5432,
      "sidecar": {
        "darwin-arm64": "bin/r0-db-postgres",
        "darwin-x64": "bin/r0-db-postgres",
        "linux-arm64": "bin/r0-db-postgres",
        "linux-x64": "bin/r0-db-postgres",
        "win32-x64": "bin/r0-db-postgres.exe"
      }
    }
  ]
}
