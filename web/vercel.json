{
  "rewrites": [
    { "source": "/install", "destination": "/install.ps1" },
    { "source": "/install.ps1", "destination": "/install.ps1" }
  ],
  "headers": [
    {
      "source": "/install(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
