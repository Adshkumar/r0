{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "r0",
    "version":  "0.1.6",
    "identifier":  "com.r0ide.ide",
    "build":  {
                  "beforeDevCommand":  "npm run vite",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build:frontend",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "r0",
                                    "width":  1280,
                                    "height":  800,
                                    "decorations":  false,
                                    "backgroundColor":  "#0a0a0a"
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "plugins":  {
                    "updater":  {
                                    "endpoints":  [
                                                      "https://github.com/Adshkumar/r0/releases/latest/download/latest.json"
                                                  ],
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzM0UzNEVEMzk4NzQ3MEUKUldRT1I0YzU3VFErSTZMOXRNa0JQWWxNYS9MZkg3VmVmMm91Vm9HV0lpTU43UnlySncwVVF0QmgK",
                                    "windows":  {
                                                    "installMode":  "quiet"
                                                }
                                }
                },
    "bundle":  {
                   "active":  true,
                   "createUpdaterArtifacts":  true,
                   "targets":  [
                                   "nsis",
                                   "msi"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "installerIcon":  "icons/icon.ico"
                                            }
                               }
               }
}